# If using Neon: prefer the direct (non "-pooler") host in this connection string.
# The pgbouncer-based pooler endpoint was observed to intermittently hang indefinitely
# on some queries when combined with channel_binding=require + psycopg2 in this project;
# the direct endpoint (drop "-pooler" from the hostname, drop channel_binding) was reliable.
DATABASE_URL=postgresql+psycopg2://memo_user:memo_pass@localhost:5432/memo_db
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME=memo_session
COOKIE_SECURE=false
ATTACHMENT_MAX_BYTES=10485760
FRONTEND_ORIGIN=http://localhost:3000
